<UserControl x:Class="QLBT.Server.Views.ClassManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1050">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- Cot trai: danh sach lop + quan ly sinh vien trong lop dang chon -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1.4*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1.2*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Danh sách lớp (toàn hệ thống)" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                <Button Name="btn_New" Content="+ Thêm lớp mới" Padding="10,4" Margin="20,0,0,0" Click="btn_New_Click" />
                <Button Name="btn_Refresh" Content="Tải lại" Padding="10,4" Margin="8,0,0,0" Click="btn_Refresh_Click" />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Tìm kiếm:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Name="tb_Search" Width="260" TextChanged="tb_Search_TextChanged" />
            </StackPanel>

            <DataGrid Grid.Row="2" Name="dg_Classes" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                      SelectionChanged="dg_Classes_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Lớp" Binding="{Binding TenLop}" Width="*" />
                    <DataGridTextColumn Header="GVCN" Binding="{Binding TenGiaoVien}" Width="140" />
                    <DataGridTextColumn Header="Học kỳ" Binding="{Binding TenHocKy}" Width="90" />
                    <DataGridTextColumn Header="Chuyên ngành" Binding="{Binding ChuyenNganh}" Width="150" />
                    <DataGridTextColumn Header="SV" Binding="{Binding SoSinhVien}" Width="45" />
                    <DataGridTextColumn Header="Bài tập" Binding="{Binding SoBaiTap}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="3" Name="tb_EnrollmentTitle" Text="Chọn một lớp để quản lý sinh viên"
                       FontWeight="Bold" FontSize="14" Margin="0,12,0,8" />

            <DataGrid Grid.Row="4" Name="dg_Enrollments" AutoGenerateColumns="False" Height="150"
                      IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                      SelectionChanged="dg_Enrollments_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="MSSV" Binding="{Binding Mssv}" Width="90" />
                    <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="*" />
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180" />
                    <DataGridCheckBoxColumn Header="Đang học" Binding="{Binding DangThamGia}" Width="70" />
                    <DataGridTextColumn Header="Ngày tham gia" Binding="{Binding NgayThamGia, StringFormat=dd/MM/yyyy}" Width="100" />
                    <DataGridTextColumn Header="Ngày rời lớp" Binding="{Binding NgayRoiLop, StringFormat=dd/MM/yyyy}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,4">
                <Button Name="btn_ReactivateStudent" Content="Cho tham gia lại" Padding="10,4" IsEnabled="False" Click="btn_ReactivateStudent_Click" />
                <Button Name="btn_RemoveStudent" Content="Cho rời lớp" Padding="10,4" Margin="8,0,0,0"
                        Background="#FFE5E5" IsEnabled="False" Click="btn_RemoveStudent_Click" />
            </StackPanel>

            <StackPanel Grid.Row="6" Orientation="Vertical" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Thêm sinh viên vào lớp (chọn nhiều, tick vào ô đầu dòng):" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Name="btn_AddSelected" Content="Thêm sinh viên đã chọn" Padding="10,4" Margin="16,0,0,0"
                            IsEnabled="False" Click="btn_AddSelected_Click" />
                </StackPanel>

                <DataGrid Name="dg_AvailableStudents" AutoGenerateColumns="False" Height="150"
                          SelectionMode="Extended" SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Chọn" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                        <DataGridTextColumn Header="MSSV" Binding="{Binding Mssv}" Width="90" IsReadOnly="True" />
                        <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>

        <!-- Cot phai: form Them / Sua lop -->
        <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Name="tb_FormTitle" Text="Thêm lớp mới" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />

                    <TextBlock Text="Giáo viên chủ nhiệm:" Margin="0,0,0,2" />
                    <ComboBox Name="cb_GiaoVien" DisplayMemberPath="HoTen" Margin="0,0,0,10" />

                    <TextBlock Text="Học kỳ:" Margin="0,0,0,2" />
                    <ComboBox Name="cb_HocKy" DisplayMemberPath="TenHocKy" Margin="0,0,0,10" />

                    <TextBlock Text="Tên lớp:" Margin="0,0,0,2" />
                    <TextBox Name="tb_TenLop" Margin="0,0,0,10" />

                    <TextBlock Text="Chuyên ngành:" Margin="0,0,0,2" />
                    <TextBox Name="tb_ChuyenNganh" Margin="0,0,0,10" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Name="btn_Save" Content="Lưu" Padding="14,6" Click="btn_Save_Click" />
                        <Button Name="btn_Cancel" Content="Hủy" Padding="14,6" Margin="8,0,0,0" Click="btn_Cancel_Click" />
                    </StackPanel>

                    <Separator Margin="0,16" />

                    <Button Name="btn_Delete" Content="Xóa lớp này" Padding="10,6"
                        Background="#FFE5E5" Click="btn_Delete_Click" Visibility="Collapsed" />
                    <TextBlock Text="Xóa lớp sẽ xóa luôn toàn bộ bài tập, bài nộp và danh sách sinh viên tham gia của lớp."
                               Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
