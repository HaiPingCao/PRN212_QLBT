<Window x:Class="QLBT.Client.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QLBT.Client"
        mc:Ignorable="d"
        Title="QLBT - Đăng nhập" Height="420" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="QLBT - Đăng nhập sinh viên" FontWeight="Bold" FontSize="18" Margin="0,0,0,20" HorizontalAlignment="Center" />

            <TextBlock Text="Địa chỉ server:" Margin="0,0,0,2" />
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <TextBox Name="tb_ServerIp" Grid.Column="0" Margin="0,0,6,0" />
                <TextBox Name="tb_ServerPort" Grid.Column="1" />
            </Grid>

            <TextBlock Text="Mã số sinh viên:" Margin="0,0,0,2" />
            <TextBox Name="tb_StudentId" Margin="0,0,0,10" />

            <TextBlock Text="Mật khẩu:" Margin="0,0,0,2" />
            <PasswordBox Name="pb_Password" Margin="0,0,0,10" KeyDown="pb_Password_KeyDown" />

            <Button Name="btn_Login" Content="Đăng nhập" Padding="0,8" Margin="0,10,0,0" Click="btn_Login_Click" />

            <TextBlock Name="tb_Status" Margin="0,14,0,0" Foreground="Red" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
