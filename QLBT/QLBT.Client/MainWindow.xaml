<Window x:Class="QLBT.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QLBT.Client"
        mc:Ignorable="d"
        Title="QLBT - Sinh viên" Height="520" Width="900" WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded" Closed="MainWindow_Closed">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Name="tb_WelcomeName" Grid.Column="0" Text="Xin chào" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
            <Button Name="btn_Logout" Grid.Column="1" Content="Đăng xuất" Padding="10,4" Click="btn_Logout_Click" />
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Assignment list -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Danh sách bài tập" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                    <Button Name="btn_Refresh" Content="Tải lại" Padding="10,4" Margin="20,0,0,0" Click="btn_Refresh_Click" />
                </StackPanel>

                <DataGrid Grid.Row="1" Name="dg_Assignments" AutoGenerateColumns="False"
                          IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                          SelectionChanged="dg_Assignments_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40" />
                        <DataGridTextColumn Header="Tiêu đề" Binding="{Binding Title}" Width="*" />
                        <DataGridTextColumn Header="Hạn nộp" Binding="{Binding DueDate, StringFormat=dd/MM/yyyy HH:mm}" Width="130" />
                        <DataGridTextColumn Header="File đề" Binding="{Binding ProblemFileName}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Detail panel -->
            <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1" Padding="12">
                <Grid>
                    <TextBlock Name="tb_NoSelection" Text="Chọn một bài tập để xem chi tiết."
                               Foreground="Gray" TextWrapping="Wrap" VerticalAlignment="Top" />

                    <ScrollViewer Name="sv_Detail" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Name="tb_DetailTitle" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,8" />

                            <TextBlock Text="Mô tả:" Margin="0,0,0,2" Foreground="Gray" />
                            <TextBlock Name="tb_DetailDescription" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <TextBlock Name="tb_DetailDue" Margin="0,0,0,10" />

                            <Button Name="btn_DownloadProblem" Content="Tải đề bài" Padding="8,4"
                                    HorizontalAlignment="Left" Click="btn_DownloadProblem_Click" />

                            <Separator Margin="0,16" />

                            <TextBlock Text="Bài nộp của bạn" FontWeight="Bold" Margin="0,0,0,8" />
                            <TextBlock Name="tb_SubmissionStatus" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <Button Name="btn_Submit" Content="Chọn file &amp; Nộp bài" Padding="8,4"
                                    HorizontalAlignment="Left" Margin="0,0,0,8" Click="btn_Submit_Click" />
                            <Button Name="btn_DownloadSubmission" Content="Tải bài đã nộp" Padding="8,4"
                                    HorizontalAlignment="Left" Margin="0,0,0,8" Click="btn_DownloadSubmission_Click" />
                            <Button Name="btn_DeleteSubmission" Content="Xóa bài nộp" Padding="8,4"
                                    Background="#FFE5E5" HorizontalAlignment="Left" Click="btn_DeleteSubmission_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <TextBlock Name="tb_GlobalStatus" Grid.Row="2" Margin="0,8,0,0" Foreground="Gray" />
    </Grid>
</Window>
