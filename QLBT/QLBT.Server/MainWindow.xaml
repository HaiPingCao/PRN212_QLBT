<Window x:Class="QLBT.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QLBT.Server"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TabControl>
            <TabItem Header="Quản lý bài tập">
                <Label Content="Tab QLBT"></Label>
            </TabItem>
            <TabItem Header="Quản lý sinh viên">
                <Label Content="Tab QLSV"></Label>
            </TabItem>
            <TabItem Header="Quản lý lớp">
                <Label Content="Tab QLL"></Label>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
