<UserControl x:Class="QLBT.Server.Views.ClassManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="900">

    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Danh sách lớp -->

        <Grid Grid.Column="0" Margin="0,0,10,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,10">

                <TextBlock Text="Danh sách lớp"
                           FontWeight="Bold"
                           FontSize="16"
                           VerticalAlignment="Center"/>

                <Button Name="btn_New"
                        Content="+ Thêm lớp"
                        Margin="20,0,0,0"
                        Padding="10,4"
                        Click="btn_New_Click"/>

                <Button Name="btn_Refresh"
                        Content="Tải lại"
                        Margin="8,0,0,0"
                        Padding="10,4"
                        Click="btn_Refresh_Click"/>

            </StackPanel>

            <DataGrid Name="dg_Classes"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      SelectionChanged="dg_Classes_SelectionChanged">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding Id}"
                                        Width="50"/>

                    <DataGridTextColumn Header="Tên lớp"
                                        Binding="{Binding TenLop}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Kỳ học"
                                        Binding="{Binding KiHoc}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Chuyên ngành"
                                        Binding="{Binding ChuyenNganh}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Số SV"
                                        Binding="{Binding SoSinhVien}"
                                        Width="80"/>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>

        <!-- Form -->

        <Border Grid.Column="1"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                Padding="12">

            <StackPanel>

                <TextBlock Name="tb_FormTitle"
                           Text="Thêm lớp mới"
                           FontWeight="Bold"
                           FontSize="14"
                           Margin="0,0,0,12"/>

                <TextBlock Text="Tên lớp"/>

                <TextBox Name="tb_TenLop"
                         Margin="0,2,0,10"/>

                <TextBlock Text="Kỳ học"/>

                <TextBox Name="tb_KiHoc"
                         Margin="0,2,0,10"/>

                <TextBlock Text="Chuyên ngành"/>

                <TextBox Name="tb_ChuyenNganh"
                         Margin="0,2,0,10"/>

                <StackPanel Orientation="Horizontal"
                            Margin="0,15,0,0">

                    <Button Name="btn_Save"
                            Content="Lưu"
                            Width="90"
                            Click="btn_Save_Click"/>

                    <Button Name="btn_Cancel"
                            Content="Hủy"
                            Width="90"
                            Margin="8,0,0,0"
                            Click="btn_Cancel_Click"/>

                </StackPanel>

                <Separator Margin="0,15"/>

                <Button Name="btn_Delete"
                        Content="Xóa lớp"
                        Background="#FFE5E5"
                        Visibility="Collapsed"
                        Click="btn_Delete_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>