<UserControl x:Class="QLBT.Server.Views.StudentManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="900">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- Danh sách sinh viên -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Danh sách sinh viên"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button Name="btn_New"
                        Content="+ Thêm sinh viên"
                        Padding="10,4"
                        Margin="20,0,0,0"
                        Click="btn_New_Click"/>

                <Button Name="btn_Refresh"
                        Content="Tải lại"
                        Padding="10,4"
                        Margin="8,0,0,0"
                        Click="btn_Refresh_Click"/>
            </StackPanel>

            <DataGrid Grid.Row="1"
                      Name="dg_Students"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      SelectionChanged="dg_Students_SelectionChanged">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="MSSV"
                                        Binding="{Binding MSSV}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Họ tên"
                                        Binding="{Binding HoTen}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Email"
                                        Binding="{Binding Email}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Lớp"
                                        Binding="{Binding TenLop}"
                                        Width="130"/>

                    <DataGridCheckBoxColumn Header="Đang học"
                                            Binding="{Binding DangThamGia}"
                                            Width="90"/>

                </DataGrid.Columns>

            </DataGrid>
        </Grid>

        <!-- Form -->
        <Border Grid.Column="1"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                Padding="12">

            <StackPanel>

                <TextBlock Name="tb_Title"
                           Text="Thêm sinh viên"
                           FontWeight="Bold"
                           FontSize="15"
                           Margin="0,0,0,12"/>

                <TextBlock Text="MSSV"/>
                <TextBox Name="tb_MSSV" Margin="0,0,0,10"/>

                <TextBlock Text="Họ tên"/>
                <TextBox Name="tb_HoTen" Margin="0,0,0,10"/>

                <TextBlock Text="Email"/>
                <TextBox Name="tb_Email" Margin="0,0,0,10"/>

                <TextBlock Text="Mật khẩu"/>
                <PasswordBox Name="tb_Password" Margin="0,0,0,10"/>

                <TextBlock Text="Lớp"/>
                <ComboBox Name="cb_Lop"
                          DisplayMemberPath="TenLop"
                          Margin="0,0,0,10"/>

                <CheckBox Name="ck_DangHoc"
                          Content="Đang tham gia"
                          Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal">
                    <Button Name="btn_Save"
                            Content="Lưu"
                            Width="80"
                            Click="btn_Save_Click"/>

                    <Button Name="btn_Cancel"
                            Content="Hủy"
                            Width="80"
                            Margin="10,0,0,0"
                            Click="btn_Cancel_Click"/>
                </StackPanel>

                <Separator Margin="0,15"/>

                <Button Name="btn_Delete"
                        Content="Xóa sinh viên"
                        Background="#FFE5E5"
                        Click="btn_Delete_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>