<UserControl x:Class="QLBT.Client.Teacher.Views.AssignmentManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="500" d:DesignWidth="900">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Danh sách bài tập" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                <Button Name="btn_New" Content="+ Thêm bài tập mới" Padding="10,4" Margin="20,0,0,0" Click="btn_New_Click" />
                <Button Name="btn_Refresh" Content="Tải lại" Padding="10,4" Margin="8,0,0,0" Click="btn_Refresh_Click" />
                <Button Name="btn_OpenProblem" Content="Mở file đề" Padding="10,4" Margin="8,0,0,0" Click="btn_OpenProblem_Click" />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Tìm kiếm:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Name="tb_Search" Width="260" TextChanged="tb_Search_TextChanged" />
            </StackPanel>

            <DataGrid Grid.Row="2" Name="dg_Assignments" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                      SelectionChanged="dg_Assignments_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40" />
                    <DataGridTextColumn Header="Tiêu đề" Binding="{Binding Title}" Width="*" />
                    <DataGridTextColumn Header="Lớp" Binding="{Binding TenLop}" Width="120" />
                    <DataGridTextColumn Header="File đề" Binding="{Binding ProblemFileName}" Width="140" />
                    <DataGridTextColumn Header="Hạn nộp" Binding="{Binding DueDate, StringFormat=dd/MM/yyyy HH:mm}" Width="130" />
                    <DataGridTextColumn Header="Số bài nộp" Binding="{Binding SubmissionCount}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1" Padding="12">
            <StackPanel>
                <TextBlock Name="tb_FormTitle" Text="Thêm bài tập mới" FontWeight="Bold" FontSize="14" Margin="0,0,0,12" />

                <TextBlock Text="Lớp:" Margin="0,0,0,2" />
                <ComboBox Name="cb_Lop" DisplayMemberPath="TenLop" Margin="0,0,0,10" />

                <TextBlock Text="Tiêu đề:" Margin="0,0,0,2" />
                <TextBox Name="tb_TieuDe" Margin="0,0,0,10" />

                <TextBlock Text="Mô tả:" Margin="0,0,0,2" />
                <TextBox Name="tb_MoTa" Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" />

                <TextBlock Text="Hạn nộp:" Margin="0,0,0,2" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <DatePicker Name="dp_HanNop" Width="160" />
                    <TextBox Name="tb_HanNopGio" Width="80" Margin="8,0,0,0" Text="23:59" />
                </StackPanel>

                <TextBlock Text="File đề:" Margin="0,0,0,2" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Name="btn_ChooseFile" Content="Chọn file..." Padding="8,4" Click="btn_ChooseFile_Click" />
                    <TextBlock Name="tb_SelectedFileName" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray" />
                </StackPanel>
                <TextBlock Name="tb_CurrentFileName" Foreground="Gray" Margin="0,0,0,10" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Name="btn_Save" Content="Lưu" Padding="14,6" Click="btn_Save_Click" />
                    <Button Name="btn_Cancel" Content="Hủy" Padding="14,6" Margin="8,0,0,0" Click="btn_Cancel_Click" />
                </StackPanel>

                <Separator Margin="0,16" />

                <Button Name="btn_Delete" Content="Xóa bài tập này" Padding="10,6"
                        Background="#FFE5E5" Click="btn_Delete_Click" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
